---
import type { ApplicationDetail } from '../../lib/db';
import { centralDateTime } from '../../lib/dates';
import { relationshipLabel } from '../../lib/relationships';
interface Props { detail: ApplicationDetail }
const { detail } = Astro.props;
const a = detail.app;
const yesno = (v: unknown) => (v === 1 || v === true ? 'Yes' : 'No');
const sizes = (m: Record<string, unknown>) =>
  [['Pants', m.pants], ['Shirt', m.shirt_top], ['Underwear', m.underwear], ['Socks', m.socks], ['Shoe', m.shoe], ['Coat', m.coat], ['Diapers', m.diapers]]
    .filter(([, v]) => v).map(([k, v]) => `${k}: ${v}`).join(', ') || '—';
const doll = (m: Record<string, unknown>) =>
  m.doll === 'white' ? 'White doll' : m.doll === 'non_white' ? 'Non-White doll' : '—';
---
<article class="slip">
  <div class="row">
    <span><strong>PU #:</strong> {a.pu_number ?? '____'}</span>
    <span><strong>People:</strong> {detail.members.length}</span>
  </div>
  <p class="name"><strong>{a.first_name} {a.last_name}</strong> — {a.phone}</p>
  <p>{a.address}, {detail.city_name}</p>
  {detail.pickup_day && (
    <p class="pickup"><strong>Pickup:</strong> {detail.pickup_day.date_text}{detail.pickup_day.description ? ` — ${detail.pickup_day.description}` : ''}</p>
  )}
  <p>
    {a.diabetic === 1 && <span class="flag">DIABETIC</span>}
    {a.bed_choice !== 'none' && <span>Bed: {a.bed_choice}{a.bed_size ? ` (${a.bed_size})` : ''}</span>}
  </p>
  <p class="facts">
    Applied: {centralDateTime(String(a.submitted_at ?? ''))}
    {a.email ? <> · Email: {String(a.email)}</> : null}
  </p>
  <p class="facts">
    Household type: {a.household_type} · OK to share with a sponsor: {yesno(a.share_with_sponsor)} · Years received help: {a.years_received_help} · Adopted last year: {yesno(a.adopted_last_year)}
  </p>
  <table>
    <caption class="sr-only">Household members, sizes, and gifts</caption>
    <thead><tr><th scope="col">Name</th><th scope="col">Relationship</th><th scope="col">Sex</th><th scope="col">Age</th><th scope="col">Sizes</th><th scope="col">Gifts wanted</th><th scope="col">Doll</th></tr></thead>
    <tbody>
      {detail.members.map((m) => (
        <tr>
          <td>{m.name}</td>
          <td>{relationshipLabel(String(m.relationship ?? ''), String(m.relationship_other ?? ''))}</td>
          <td>{m.sex}</td>
          <td>{m.age}</td>
          <td>{sizes(m)}</td>
          <td>{m.gifts || '—'}</td>
          <td>{doll(m)}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <div class="notes-area">
    <p class="notes-label">Notes</p>
    <div class="rule"></div>
    <div class="rule"></div>
    <div class="rule"></div>
    <div class="rule"></div>
    <div class="rule"></div>
  </div>
</article>
<style>
  /* Sherlyn's layout: each slip prints on its own page with a Notes area
     at the bottom for handwriting. min-height removed so slips don't grow
     beyond their content. */
  .slip { border: 2px solid #000; padding: 14px; margin: 0 0 12px; font-size: 16px; break-inside: avoid; box-sizing: border-box; }
  .row { display: flex; gap: 24px; font-size: 20px; }
  .name { font-size: 22px; margin: 8px 0 2px; }
  .pickup { font-size: 18px; margin: 4px 0; }
  .facts { font-size: 16px; margin: 4px 0; }
  /* Seven columns (Name, Relationship, Sex, Age, Sizes, Gifts wanted, Doll)
     crowd the 16px base — drop the table alone to 14px so it still fits;
     every other line on the slip stays at 16px+ per the print-legibility rule. */
  table { width: 100%; border-collapse: collapse; margin-top: 8px; font-size: 14px; }
  th, td { border: 1px solid #666; padding: 4px 6px; text-align: left; }
  .flag { font-weight: bold; color: #b91c1c; margin-right: 8px; }
  .notes-area { margin-top: 14px; }
  .notes-label { font-weight: 700; margin: 0 0 2px; font-size: 16px; }
  .rule { border-bottom: 1px solid #999; height: 1.7em; }
  @media print { .slip { page-break-after: always; } }
  /* No forced break after the final slip — avoids a trailing blank sheet. */
  @media print { .slip:last-of-type { page-break-after: auto; } }
  /* This component's pages (slips.astro, [id]/slip.astro) intentionally
     don't import global.css, so Tailwind's sr-only utility isn't loaded
     here — define the same visually-hidden technique locally. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
