---
// The mailed Pick Up Notices, three to a page with cut lines — Sherlyn prints
// a town's stack when it's ready, cuts, and mails them (her paper-form
// workflow, built 2026-07-31). Same view scoping as the packing-slips page.
import PickupNoticeCard from '../../../components/admin/PickupNoticeCard.astro';
import { listApprovedForSlips, listCities, latestSeason } from '../../../lib/db';
export const prerender = false;
const url = new URL(Astro.request.url);
// Same fallback as the applications list: param wins, then the latest
// season with data, then the calendar year.
const season = Number(url.searchParams.get('season')) || (await latestSeason(Astro.locals.runtime.env.DB)) || new Date().getFullYear();
// Same parsing as export.xlsx.ts: town id / 'mailed' / 'stragglers' / 'adopted' / unset.
const townRaw = url.searchParams.get('town') ?? '';
const town: number | 'mailed' | 'stragglers' | 'adopted' | null =
  townRaw === 'mailed' ? 'mailed' : townRaw === 'stragglers' ? 'stragglers' : townRaw === 'adopted' ? 'adopted' :
  /^\d+$/.test(townRaw) && Number(townRaw) > 0 ? Number(townRaw) : null;

const all = await listApprovedForSlips(Astro.locals.runtime.env.DB, season);
const cities = await listCities(Astro.locals.runtime.env.DB);
// Mailed and adopted households never reach listApprovedForSlips (excluded at
// the query level), so those views are presentational notes only.
const notices =
  town === 'mailed' ? [] :
  town === 'adopted' ? [] :
  typeof town === 'number' ? all.filter((d) => Number(d.app.city_id) === town) :
  town === 'stragglers' ? all.filter((d) => d.app.straggler === 1) :
  all;

const viewLabel =
  town === 'mailed' ? 'Mailed' :
  town === 'stragglers' ? 'Stragglers' :
  town === 'adopted' ? 'Adopted' :
  typeof town === 'number' ? (cities.find((c) => c.id === town)?.name ?? 'All towns') :
  'All towns';
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Pickup slips {season}</title></head>
  <body style="margin:16px;font-family:Georgia,serif;">
    <p class="no-print"><a href="/admin/applications">&larr; Back to applications</a>
      {town !== 'mailed' && town !== 'adopted' && <> · <button type="button" data-print>Print all {notices.length} pickup slips (3 per page)</button></>}</p>
    <h1 style="font-size:20px;">Pick up notices to mail — {viewLabel} — {season} ({notices.length})</h1>
    <p class="no-print" style="font-size:15px;">Three per page with dashed cut lines — print, cut, and mail one to each family.</p>
    {town === 'mailed' && (
      <p>Mailed (elderly &amp; disabled) households don't pick up — their gift and food cards come inside
        their Christmas card. Use the "Elderly &amp; disabled (mailed)" view's Print mailing labels instead.</p>
    )}
    {town === 'adopted' && (
      <p>Adopted households don't get pickup slips — the adopting organization or family arranges
        gifts with them directly.</p>
    )}
    {town !== 'mailed' && town !== 'adopted' && notices.length === 0 && <p>No approved applications yet.</p>}
    {notices.map((d) => <PickupNoticeCard detail={d} />)}
    <style>
      button:hover, a:hover { text-decoration: underline; background: #eee; }
      button:focus-visible, a:focus-visible { outline: 2px solid #14532d; outline-offset: 2px; }
      @media print { .no-print, h1 { display: none; } }
    </style>
    <script src="/scripts/print-button.js" defer></script>
  </body>
</html>
