---
import BoxCard from '../../../components/admin/BoxCard.astro';
import { listApprovedForSlips, listCities } from '../../../lib/db';
import { bandColorFor, bandLabelFor } from '../../../lib/box-cards';
export const prerender = false;
const url = new URL(Astro.request.url);
const season = Number(url.searchParams.get('season')) || new Date().getFullYear();
// Same parsing as export.xlsx.ts: town id / 'mailed' / 'stragglers' / unset.
const townRaw = url.searchParams.get('town') ?? '';
const town: number | 'mailed' | 'stragglers' | null =
  townRaw === 'mailed' ? 'mailed' : townRaw === 'stragglers' ? 'stragglers' :
  /^\d+$/.test(townRaw) && Number(townRaw) > 0 ? Number(townRaw) : null;

const allSlips = await listApprovedForSlips(Astro.locals.runtime.env.DB, season);
const cities = await listCities(Astro.locals.runtime.env.DB);
// Mailed households never reach listApprovedForSlips (excluded at the query
// level already), so the 'mailed' view is presentational only — no filter to run.
const slips =
  town === 'mailed' ? [] :
  typeof town === 'number' ? allSlips.filter((d) => Number(d.app.city_id) === town) :
  town === 'stragglers' ? allSlips.filter((d) => d.app.straggler === 1) :
  allSlips;

const viewLabel =
  town === 'mailed' ? 'Mailed' :
  town === 'stragglers' ? 'Stragglers' :
  typeof town === 'number' ? (cities.find((c) => c.id === town)?.name ?? 'All towns') :
  'All towns';
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Box cards {season}</title></head>
  <body style="margin:16px;font-family:system-ui,sans-serif;">
    <p class="no-print"><a href="/admin/applications">&larr; Back to applications</a>
      {town !== 'mailed' && <> · <button type="button" data-print>Print all {slips.length} cards</button></>}</p>
    <h1 class="no-print" style="font-size:20px;">Box cards — {viewLabel} — {season} ({slips.length})</h1>
    {town === 'mailed' && (
      <p>Mailed households don't get pickup slips or box cards — they receive gift and food cards by mail. Use the applications list's "Elderly &amp; disabled (mailed)" view to print the mail list with addresses.</p>
    )}
    {town !== 'mailed' && slips.length === 0 && <p>No approved applications yet.</p>}
    <div class="sheet">
      {slips.map((d) => {
        const straggler = d.app.straggler === 1;
        return (
          <BoxCard
            band={bandColorFor(cities, Number(d.app.city_id), straggler)}
            label={bandLabelFor(d.city_name, straggler)}
            puNumber={(d.app.pu_number as number | null) ?? null}
            bags={(d.app.bags_count as number | null) ?? null}
          />
        );
      })}
    </div>
    <style>
      .sheet { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
      @media print { .no-print { display: none; } .sheet { gap: 12px; } }
    </style>
    <script src="/scripts/print-button.js" defer></script>
  </body>
</html>
