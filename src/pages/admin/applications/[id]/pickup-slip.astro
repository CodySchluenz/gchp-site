---
// One family's mailed Pick Up Notice — the single-slip sibling of the bulk
// pickup-slips page, for late approvals and one-off reprints (2026-07-31).
import PickupNoticeCard from '../../../../components/admin/PickupNoticeCard.astro';
import { getApplicationDetail } from '../../../../lib/db';
export const prerender = false;
const id = Number(Astro.params.id);
const detail = Number.isInteger(id) ? await getApplicationDetail(Astro.locals.runtime.env.DB, id) : null;
const mailed = detail ? detail.app.household_type === 'elderly' || detail.app.household_type === 'disabled' : false;
const adopted = detail ? detail.app.adopted === 1 : false;
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{detail ? `Pickup slip — ${detail.app.first_name} ${detail.app.last_name}` : 'Pickup slip'}</title></head>
  <body style="margin:16px;font-family:Georgia,serif;">
    {detail ? (
      <>
        <div class="no-print">
          <h1 style="font-size:20px;margin:0 0 8px;">Pickup slip to mail</h1>
          <p><a href={`/admin/applications/${id}`}>&larr; Back</a>{!mailed && !adopted && <> · <button type="button" data-print>Print this slip</button></>}</p>
        </div>
        {adopted ? (
          <p>Adopted household — no pickup slip; the adopting organization or family arranges gifts with them directly.</p>
        ) : mailed ? (
          <p>Mailed household — no pickup slip. Their gift and food cards come inside their Christmas card.</p>
        ) : (
          <PickupNoticeCard detail={detail} />
        )}
      </>
    ) : <p>That application could not be found.</p>}
    <style>
      button:hover, a:hover { text-decoration: underline; background: #eee; }
      button:focus-visible, a:focus-visible { outline: 2px solid #14532d; outline-offset: 2px; }
      @media print { .no-print { display: none; } }
    </style>
    <script src="/scripts/print-button.js" defer></script>
  </body>
</html>
