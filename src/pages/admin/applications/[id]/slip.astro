---
import SlipCard from '../../../../components/admin/SlipCard.astro';
import { getApplicationDetail } from '../../../../lib/db';
export const prerender = false;
const id = Number(Astro.params.id);
const detail = Number.isInteger(id) ? await getApplicationDetail(Astro.locals.runtime.env.DB, id) : null;
const mailed = detail ? detail.app.household_type === 'elderly' || detail.app.household_type === 'disabled' : false;
const adopted = detail ? detail.app.adopted === 1 : false;
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{detail ? `Packing slip — ${detail.app.first_name} ${detail.app.last_name}` : 'Packing slip'}</title></head>
  <body style="margin:16px;font-family:Georgia,serif;">
    {detail ? (
      <>
        <div class="no-print">
          <h1 style="font-size:20px;margin:0 0 8px;">Packing slip</h1>
          <p><a href={`/admin/applications/${id}`}>&larr; Back</a>{!mailed && <> · <button type="button" data-print>Print this slip</button></>}</p>
          {adopted && (
            <p><strong>Adopted household</strong> — this copy is for the adopting organization or
              family (print it, or use your browser's print-to-PDF to email it). The packers' pile
              never includes them.</p>
          )}
        </div>
        {mailed ? (
          <p>Mailed household — no packing slip. They receive gift and food cards by mail.</p>
        ) : (
          <SlipCard detail={detail} />
        )}
      </>
    ) : <p>That application could not be found.</p>}
    <style>
      button:hover, a:hover { text-decoration: underline; background: #eee; }
      button:focus-visible, a:focus-visible { outline: 2px solid #14532d; outline-offset: 2px; }
      @media print { .no-print { display: none; } }
    </style>
    <script src="/scripts/print-button.js" defer></script>
  </body>
</html>
