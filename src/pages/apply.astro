---
import '../styles/global.css';
import Site from '../layouts/Site.astro';
import { getSettings } from '../lib/db';
export const prerender = false;

const env = Astro.locals.runtime.env;
const settings = await getSettings(env.DB);
const open = settings.applications_open === 1;
---
<Site title="Apply" description="Apply online for holiday food, gifts, and clothing in Grant County, Wisconsin — choose the Family Household or Elderly/Disabled Household application, whichever fits you. One short form, no account needed — or call the message line or use a paper application. Your information stays private.">
  {!open ? (
    <>
      <h1 class="text-3xl font-bold text-holly-800">Apply for Holiday Help</h1>
      <p class="mt-4">
        Applications are closed right now. This year's opening date is posted on the
        <a href="/" class="font-semibold text-holly-800 underline">front page</a>, and the online
        application will be right here when they open.
      </p>
      <div class="mt-6 rounded border-l-4 border-berry-700 bg-white p-4">
        <h2 class="text-xl font-bold text-holly-800">You can always reach us these two ways:</h2>
        <ul class="mt-2 list-disc space-y-2 pl-6">
          <li>
            <strong>By phone:</strong> call our message line at <strong>608-723-2136 ext 1194</strong>.
            Speak slowly and leave your name, address, and whether you are a family or elderly household.
          </li>
          <li>
            <strong>On paper:</strong>
            <a href="/application.pdf" class="font-semibold text-berry-700 underline">print the paper application</a>
            and mail it back to the address printed on the form.
          </li>
        </ul>
      </div>
      <p class="mt-6">Your information is always private. We use it only to prepare your family's gifts.</p>
    </>
  ) : (
    <>
      <h1 class="text-3xl font-bold text-holly-800">Apply for Holiday Help</h1>
      <p class="mt-4">Pick the application that fits your household — both are short.</p>

      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <a href="/apply/family" class="block rounded-lg border-2 border-holly-700 bg-white p-5 hover:bg-holly-100">
          <span class="text-xl font-bold text-holly-800">Family Household</span>
          <span class="mt-1 block">Children under 18 live with you.</span>
        </a>
        <a href="/apply/elderly" class="block rounded-lg border-2 border-holly-700 bg-white p-5 hover:bg-holly-100">
          <span class="text-xl font-bold text-holly-800">Elderly/Disabled Household</span>
          <span class="mt-1 block">You are over 65, or receive Social Security or SSI for a disability.</span>
        </a>
      </div>

      <div class="mt-6 rounded border-l-4 border-berry-700 bg-white p-4">
        <p><strong>Rather not do this online?</strong> That's just fine:</p>
        <ul class="mt-2 list-disc space-y-1 pl-6">
          <li>Call our message line at <strong>608-723-2136 ext 1194</strong> and we'll mail you a paper application.</li>
          <li>Or print a paper application and mail it back to the address printed on the form:
            <ul class="mt-1 list-disc space-y-1 pl-6">
              <li><a href="/application.pdf" class="font-semibold text-berry-700 underline">Family paper application</a></li>
              <li><a href="/elderly-application.pdf" class="font-semibold text-berry-700 underline">Elderly/Disabled paper application</a></li>
            </ul>
          </li>
        </ul>
      </div>

      <p class="mt-4">Your information is always private. We use it only to prepare your family's gifts.</p>
    </>
  )}
</Site>
